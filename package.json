{
  "name": "cocos-challenge",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "APP_ENV=${APP_ENV:-dev} nest start",
    "start:dev": "APP_ENV=${APP_ENV:-dev} nest start --watch",
    "start:debug": "APP_ENV=${APP_ENV:-dev} nest start --debug --watch",
    "start:prod": "APP_ENV=${APP_ENV:-prod} node dist/main",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:feature": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns steps",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns spec",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "migration:generate": "sh -c 'typeorm-ts-node-commonjs migration:generate -d db/dataSource.ts --pretty \"db/migrations/${1:?Usage: npm run migration:generate -- <Name>}\"' --",
    "migration:create": "sh -c 'typeorm-ts-node-commonjs migration:create \"db/migrations/${1:?Usage: npm run migration:create -- <Name>}\"' --",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d db/dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d db/dataSource.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "jest-cucumber": "^4.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
