{
  "info": {
    "name": "Cocos Challenge",
    "description": "Manual tests for the Cocos challenge API.\n\nRun it top to bottom (Collection Runner) or request by request: \"0. Setup\" looks up\ninstrument ids by ticker and creates a fresh user, and later requests reuse the ids\nit saves in collection variables.\n\nPrerequisites:\n1. `npm run db:up`\n2. `APP_ENV=dev npm run migration:run`\n3. `npm run start:dev`\n\n\"7. Reference data\" needs ENABLE_REFERENCE_DATA_ENDPOINTS=true (set in .env.dev).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "seededUserId",
      "value": "1"
    },
    {
      "key": "arsId",
      "value": ""
    },
    {
      "key": "pampId",
      "value": ""
    },
    {
      "key": "pampClose",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "marketBuyId",
      "value": ""
    },
    {
      "key": "limitBuyId",
      "value": ""
    },
    {
      "key": "limitSellId",
      "value": ""
    },
    {
      "key": "newInstrumentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Looks up the ids the rest of the collection uses and creates a fresh user.",
      "item": [
        {
          "name": "Look up ARS (cash)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?ticker=ARS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "ticker",
                  "value": "ARS"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const ars = pm.response.json().items.find((i) => i.ticker === 'ARS');",
                  "pm.test('ARS exists', () => pm.expect(ars).to.exist);",
                  "pm.collectionVariables.set('arsId', ars.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Look up PAMP",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?ticker=PAMP",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "ticker",
                  "value": "PAMP"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const pamp = pm.response.json().items.find((i) => i.ticker === 'PAMP');",
                  "pm.test('PAMP has a price', () => pm.expect(pamp.close).to.be.above(0));",
                  "pm.collectionVariables.set('pampId', pamp.id);",
                  "pm.collectionVariables.set('pampClose', pamp.close);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manual-{{$timestamp}}@test.local\",\n  \"accountNumber\": \"PM{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Instruments",
      "description": "Search by ticker and/or name: partial, case-insensitive; both filters must match.",
      "item": [
        {
          "name": "All instruments (first 50, by ticker)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const tickers = pm.response.json().items.map((i) => i.ticker);",
                  "pm.test('sorted by ticker', () => pm.expect(tickers).to.eql([...tickers].sort((a, b) => a.localeCompare(b))));",
                  "pm.test('at most 50', () => pm.expect(tickers.length).to.be.at.most(50));"
                ]
              }
            }
          ]
        },
        {
          "name": "By ticker (partial, any case)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?ticker=pa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "ticker",
                  "value": "pa"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every ticker contains PA', () => pm.response.json().items.forEach((i) => pm.expect(i.ticker).to.include('PA')));"
                ]
              }
            }
          ]
        },
        {
          "name": "By name (partial, any case)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?name=grupo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "grupo"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every name contains grupo', () => pm.response.json().items.forEach((i) => pm.expect(i.name.toLowerCase()).to.include('grupo')));"
                ]
              }
            }
          ]
        },
        {
          "name": "By ticker and name (both must match)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?ticker=G&name=galicia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "ticker",
                  "value": "G"
                },
                {
                  "key": "name",
                  "value": "galicia"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only GGAL', () => pm.expect(pm.response.json().items.map((i) => i.ticker)).to.eql(['GGAL']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wildcards are literal (empty)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?name=%25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "%25"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no results', () => pm.expect(pm.response.json().items).to.eql([]));"
                ]
              }
            }
          ]
        }
      ]
    },
