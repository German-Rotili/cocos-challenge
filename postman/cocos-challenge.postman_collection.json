    {
      "name": "4. Order lookup and cancel",
      "description": "Only NEW orders can be cancelled.",
      "item": [
        {
          "name": "Get the market buy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{marketBuyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{marketBuyId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is FILLED', () => pm.expect(pm.response.json().status).to.eql('FILLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel the limit buy",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{limitBuyId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{limitBuyId}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
